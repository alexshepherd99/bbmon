[Unit]
Description=bbmon configuration install
Documentation=https://github.com/alexshepherd99/bbmon
# Started by bbmon-config.path, never enabled — hence no [Install] section,
# the same rule bbmon-reboot.service follows.
#
# It runs as root because /etc/bbmon/config.yaml is root-owned and must stay
# that way. Unlike bbmon-reboot.service, this one does run bbmon's own code as
# root, which is a real difference and the reason for the sandboxing below:
# the reboot unit could avoid Python entirely, and this one cannot, because
# refusing a bad proposal means parsing it.
#
# It takes no argument and reads no configuration to decide what to do. The
# only input is that a file was written, and bbmon.configstore names both paths
# literally — a process that runs as root must not take direction from the file
# it is being asked to replace.

[Service]
Type=oneshot
ExecStart=/opt/bbmon/.venv/bin/python -m bbmon.configstore

# Root, but in the bbmon group, and that group is its only access to bbmon's
# files. The empty bounding set below removes CAP_DAC_OVERRIDE and CAP_CHOWN,
# so plain root here could not read a proposal the web app staged at 0640,
# delete it from /var/lib/bbmon, or give the installed file its bbmon group —
# all three refused on the Pi at G5, 2026-09-12. As a member of the group it
# can: the proposal is group-readable, the state directory is group-writable
# (StateDirectoryMode=0775 on every unit that takes it), and an owner may give
# a file any group it belongs to. User= stays unset: the destination is
# root-owned and must stay that way.
Group=bbmon

# What connects an installed configuration to the services running on the old
# one. Without it a save from the admin page reaches /etc/bbmon/config.yaml and
# stops there until someone restarts three units by hand, which on a headless
# Pi is most of the point of having the page at all.
#
# try-reload-or-restart: a unit that is not running is left alone rather than
# started by a configuration change, and each of the three declares ExecReload=
# so this is a SIGHUP and never a restart. A fixed argv naming three units —
# nothing here comes from the proposal, which is the rule this whole unit is
# built on.
#
# The leading `-` keeps a failed reload from marking this unit failed: the
# configuration *was* installed, and saying otherwise would send anyone
# debugging it to the wrong place. systemctl still writes its own error to the
# journal.
ExecStartPost=-/usr/bin/systemctl try-reload-or-restart bbmon-pinger.service bbmon-speedtest.service bbmon-web.service

# Deliberately NOT StateDirectory=bbmon, which every other unit uses. This unit
# has no User=, so systemd would chown /var/lib/bbmon to root — leaving every
# actual bbmon service unable to write its own database. The grant it needs is
# a plain read-write path.
ReadWritePaths=/etc/bbmon /var/lib/bbmon

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# No capability at all. Root here is about owning the file it installs; the
# bbmon group covers everything else it touches — see Group= above.
CapabilityBoundingSet=
