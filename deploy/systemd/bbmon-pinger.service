[Unit]
Description=bbmon ping monitor
Documentation=https://github.com/alexshepherd99/bbmon
Requires=bbmon-init.service
After=bbmon-init.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bbmon
Group=bbmon
# BBMON_REBOOT=systemd is what turns requirement 6's periodic reboot on: the
# schedule runs inside the ping loop (see bbmon/pinger.py) and writes the file
# bbmon-reboot.path watches. The default everywhere else is a no-op, so a
# development machine cannot reboot itself.
Environment="BBMON_CONFIG=/etc/bbmon/config.yaml" "BBMON_REBOOT=systemd"
ExecStart=/opt/bbmon/.venv/bin/python -m bbmon.pinger
# Requirement 2's reload: the service finishes its cycle, writes what it has
# buffered, and rebuilds itself from the configuration file. bbmon-config.service
# sends this after installing a save, so an edit from the admin page takes
# effect without anything being restarted.
ExecReload=/bin/kill -HUP $MAINPID

# Requirement 10: a crashed collector recovers on its own.
Restart=on-failure
RestartSec=5

# SIGTERM is handled in bbmon.service.run_until_stopped so the buffer is
# written on the way down; the default KillSignal is already SIGTERM, and
# this timeout gives the final flush room to complete before SIGKILL.
TimeoutStopSec=30

StateDirectory=bbmon

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# NoNewPrivileges=yes makes the kernel ignore /usr/bin/ping's cap_net_raw file
# capability, so ping would fall back to a raw socket and fail with
# "Operation not permitted". bootstrap.sh therefore puts the bbmon group inside
# net.ipv4.ping_group_range, which lets ping use an unprivileged ICMP datagram
# socket needing no capability at all. Verified on 2026-08-12 — see log.md.
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
