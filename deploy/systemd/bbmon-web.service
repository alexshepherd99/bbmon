[Unit]
Description=bbmon web dashboard
Documentation=https://github.com/alexshepherd99/bbmon
Requires=bbmon-init.service
After=bbmon-init.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bbmon
Group=bbmon
# BBMON_REBOOT=systemd is what makes requirement 8's force-reboot button do
# anything: it writes the file bbmon-reboot.path watches, exactly as the
# pinger's schedule does. Without it the button would answer "requested" and
# nothing would happen. Still no privilege here — see bbmon/reboot.py.
Environment="BBMON_CONFIG=/etc/bbmon/config.yaml" "BBMON_REBOOT=systemd"
ExecStart=/opt/bbmon/.venv/bin/python -m bbmon.web
# Requirement 2's reload — see bbmon-pinger.service. This one replaces the
# settings its routes read rather than rebuilding: it is inside a serving loop
# with a socket bound, so web.host and web.port still need a restart and the
# journal says so when either changes.
ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=5

StateDirectory=bbmon

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# The configured port is 8080, above 1024, so binding needs no capability.
# If web.port is ever set below 1024 this unit will fail to bind rather than
# quietly gaining a privilege.
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
